# VEYRA EDUCATE .ENV EXAMPLE
APP_NAME="VEYRA EDUCATE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://veyracreative.site
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
FILESYSTEM_DISK=local
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
SCHOOL_APP_SQL_STRICT=true
SSO_SECRET_KEY=
SSO_CBT_URL=
SSO_ALLOWED_HOSTS=veyracreative.site
SSO_TOKEN_TTL=300
INVOICE_SIGNER_NAME="Ahmad Fauzi, S.Kom., M.T."
INVOICE_SIGNER_TITLE="Finance & Licensing Manager"
INVOICE_SIGNER_CITY="Sumenep"
SCHOOL_LOOKUP_API=https://api.fazriansyah.eu.org/v1/sekolah

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=veyra_educate_local
DB_USERNAME=root
DB_PASSWORD=

# Redis (opsional — dihilangkan jika tidak dipakai)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Mail (log untuk local, SMTP untuk production)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STACK=single
LOG_DAILY_DAYS=14

# WhatsApp (opsional)
WHATSAPP_ENABLED=false
WHATSAPP_GATEWAY=fonnte
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_NUMBER=

# CBT / Ujian Online
CBT_DB_DATABASE=cbtonline_db
