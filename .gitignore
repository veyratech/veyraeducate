# ============================================
# VEYRA EDUCATE — .gitignore
# ============================================

# Environment & secrets
.env
.env.local
.env.production
!.env.example

# Dependencies
vendor/
node_modules/

# Storage (uploaded files, logs, cache)
storage/framework/cache/*
!storage/framework/cache/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore
storage/app/public/*
!storage/app/public/.gitignore
storage/app/private/*
!storage/app/private/.gitignore
storage/app/marketing/*
!storage/app/marketing/.gitignore
storage/app/settings/*
!storage/app/settings/.gitignore
storage/backups/*
!.gitignore

# Public storage symlink (akan dibuat otomatis di server)
public/storage
!public/storage/.gitignore

# Build output
build/
manifest.json
css/

# PHP unit cache
.phpunit.result.cache

# IDE & editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Zip backup
*.zip

# Composer lock (opsional — uncomment jika ingin commit)
# composer.lock

# Environment backups & staging
.env.*.bak
.staging/
backend/

# Temporary dev scripts & test files
_check.ps1
_gitlog.ps1
_get-error.ps1
_build-zip.ps1
_find-405.php
_test-storage-path.php
_check-storage.ps1
_verify-storage.ps1
_test-admin-guides.ps1
_test-assets.ps1
_test-guides.ps1
_test-site.ps1
_test-storage.ps1
test-*.ps1
login_page.html
_home.html
build-zip.ps1
check-storage.ps1
find_405.php
get-error.ps1
verify-storage.ps1

# Generated bootstrap cache (machine-specific, should not be committed)
bootstrap/cache/config.php
bootstrap/cache/events.php
bootstrap/cache/packages.php
bootstrap/cache/routes-v7.php
bootstrap/cache/services.php
